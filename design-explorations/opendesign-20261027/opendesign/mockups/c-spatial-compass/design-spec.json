  "interactions": [
    {
      "target": "connect / disconnect / demo / csv",
      "behavior": "Preview toast only. No serial access, no network, no file export."
    },
    {
      "target": "unit-mm / unit-cm",
      "behavior": "Local preview: mm maps raw1284 to128.4cm; cm maps to1284cm, outside 10–1200cm validity range, so current laser reading becomes em dash and laser curve clears. Ultrasound unchanged."
    },
    {
      "target": "legend-tf / legend-front / legend-upper",
      "behavior": "Toggle corresponding curve only; upper also toggles timeout shading."
    },
    {
      "target": "diagnostics",
      "behavior": "Native details disclosure shows clearly labelled demo log."
    }
  ],
  "scientificBoundaries": [
    "传感器朝向静态示意；距离刻度非等比；非地图、雷达扫描或3D重建。",
    "三路独立更新时间和状态；三路测量不同步。",
    "激光解析间隔不代表真实采样间隔。",
    "TF原始单位只影响激光显示换算，不修改传感器配置。",
    "演示数据不代表实物测距验证。"
