[Unit]
Description=Smart cane V2 shared camera vision
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=%h/EE3070-project
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/EE3070-project/.venv/bin/python -m cane.vision.v2 --config config/camera.v2.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
