[
  {"id":1,"group":"室内 · 自动","case":"蓝色地面","setup":"对准干燥蓝地板或蓝地毯。","expect":"没有积水或坑洞提示。","kind":"image","media":"SmartCaneRuntime/indoor-confounders-20261030/photos/122433233.jpg","avoid":["puddle_ahead","pothole_ahead","damaged_pavement"]},
  {"id":2,"group":"室内 · 自动","case":"黑鞋和包","setup":"在地上放一双深色鞋，可加一个包。","expect":"没有坑洞提示。","kind":"image","media":"SmartCaneRuntime/indoor-confounders-20261030/photos/95549323.jpg","avoid":["pothole_ahead","damaged_pavement"]},
  {"id":3,"group":"室内 · 自动","case":"平面圆形图案","setup":"对准圆形地垫或贴在地上的圆形图案。","expect":"没有坑洞提示。","kind":"image","media":"SmartCaneRuntime/indoor-confounders-20261030/photos/synthetic-floor-circles.png","synthetic":true,"avoid":["pothole_ahead","damaged_pavement"]},
  {"id":4,"group":"室内 · 自动","case":"反光地面","setup":"朝有灯光倒影的干燥地面缓慢转动。","expect":"没有积水提示。","kind":"image","media":"SmartCaneRuntime/indoor-validation-20261030/photos/32936238.jpg","avoid":["puddle_ahead"]},
  {"id":5,"group":"室内 · 自动","case":"楼梯","setup":"从平地对着一段清楚可见的室内楼梯。","expect":"听到楼梯提醒。","kind":"video","media":"SmartCaneRuntime/comprehensive-new-videos-20261103/media/mixkit-22148.mp4","seconds":13,"want":["stairs_ahead"]},
  {"id":6,"group":"室内 · 自动","case":"密集人群","setup":"让一组人聚在画面前方，或回放室内人群。","expect":"持续密集时提示人群。","kind":"image","media":"SmartCaneRuntime/crowd-awareness-20261102/media/qa-composite-448.jpg","synthetic":true,"want":["crowd_ahead"]},
  {"id":7,"group":"室内 · 自动","case":"零散行人","setup":"让一两个人走过，彼此留出空隙。","expect":"没有人群提示。","kind":"video","media":"SmartCaneRuntime/comprehensive-new-videos-20261103/media/mixkit-9060.mp4","seconds":6.5,"avoid":["crowd_ahead"]},
  {"id":8,"group":"室内 · 自动","case":"近距告警抢占","setup":"问一个视觉问题。播报时让障碍物靠近 Pico。","expect":"近距提示抢占回答，Pico 收到震动指令。","kind":"integrated","key":"preemption"},
  {"id":9,"group":"室内 · Ollama","case":"实验室环境","setup":"对准实验室或走廊，按住说 “Describe my surroundings.”","expect":"简短说出可见的场景或设施。","kind":"voice","media":"Ollama/vlm-eval/images/H01.jpg","question":"Describe my surroundings.","match":"corridor|hallway|passage","reference":"室内走廊，有玻璃和黄色墙面。"},
  {"id":10,"group":"室内 · Ollama","case":"椅子方向","setup":"让椅子处于画面一侧，问 “Is the chair on my left or right?”","expect":"答对椅子所在侧。","kind":"voice","media":"Ollama/vlm-eval/images/T06.jpg","question":"Is the chair on my left or right?","match":"\\bright\\b","avoid_text":"\\b(?:on|to) (?:the |your |my )?left\\b","reference":"近处椅子在画面右侧。"},
  {"id":11,"group":"室内 · Ollama","case":"地上物件","setup":"在地上放箱子，问 “What is on the floor?”","expect":"说出箱子或纸箱。","kind":"voice","media":"Ollama/vlm-eval/images/H03.jpg","question":"What is on the floor?","match":"box(?:es)?|cardboard","reference":"地面上是多个纸箱。"},
  {"id":12,"group":"室内 · Ollama","case":"小道具","setup":"把玩具放在凳上，问 “What is on the stool?”","expect":"说出玩具或毛绒狗。","kind":"voice","media":"Ollama/vlm-eval/images/T04.jpg","question":"What is on the stool?","match":"toy|stuffed|plush","reference":"编织凳上是毛绒玩具狗。"},
  {"id":13,"group":"室内 · Ollama","case":"暗处不确定","setup":"对准暗处，问 “What is on the floor in the dark?”","expect":"说明看不清。","kind":"voice","media":"Ollama/vlm-eval/images/T09.jpg","question":"What is on the floor in the dark?","match":"can't|cannot|unable|unclear|dark|difficult|hard to (?:see|tell)","reference":"暗处没有可确认的前景物体。"},
  {"id":14,"group":"室内 · Ollama","case":"左右通道","setup":"对准有分支的走廊，问 “Does the hallway go left, right, or both ways?”","expect":"描述两边可见的通道。","kind":"voice","media":"Ollama/vlm-eval/images/H07.jpg","question":"Does the hallway go left, right, or both ways?","match":"both|left.*right|right.*left","reference":"中间墙两侧均有通道。"},
  {"id":15,"group":"室内 · 语音","case":"询问是否安全","setup":"对准一个入口，问 “Is the way ahead clear?”","expect":"明确说明无法判断通行是否安全。","kind":"voice","media":"Ollama/vlm-eval/images/T12.jpg","question":"Is the way ahead clear?","match":"can't|cannot|unable|not (?:tell|determine|judge)","reference":"照片无法判断通行安全。"},
  {"id":16,"group":"导航","case":"确认与查询","setup":"按键说 “Navigate to CityU Library”，答 Yes，再问状态或下一步。","expect":"确认后才规划，状态查询读取当前路线。","kind":"integrated","key":"plan"},
  {"id":17,"group":"导航","case":"拒绝和结束","setup":"第一次确认时答 No。启动路线后说 “Stop navigation.”","expect":"拒绝不发起规划，停止后路线关闭。","kind":"integrated","key":"cancel"},
  {"id":18,"group":"导航","case":"定位丢失","setup":"启动一条测试路线，停止共享定位。","expect":"定位过期后取消导航并播报。","kind":"integrated","key":"search"},
  {"id":19,"group":"室外 · 自动","case":"可见积水","setup":"从干燥处拍摄明显的水潭或回放视频。","expect":"积水进入画面前方后提示。","kind":"video","media":"SmartCaneRuntime/comprehensive-new-videos-20261103/media/mixkit-1324.mp4","seconds":7.5,"want":["puddle_ahead"]},
  {"id":20,"group":"室外 · 自动","case":"明显坑洞","setup":"从安全位置对准有清晰边缘的坑洞或回放照片。","expect":"出现坑洞或路面损坏提醒，两者都可接受。","kind":"image","media":"SmartCaneRuntime/indoor-confounders-20261030/photos/hf-test-37.jpg","want":["pothole_ahead","damaged_pavement"]}
]
